rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== REGLA PARA CLIENTES (VERSIÓN DEFINITIVA) ==========
    match /artifacts/{appId}/public/data/clientes/{clienteId} {
      // Permitir lectura si:
      // 1. El cliente está activo (para menú público) → SIN autenticación
      // 2. El usuario es Super Admin → puede ver todo
      // 3. El usuario es el dueño de este cliente → puede verlo aunque esté inactivo
      allow read: if resource.data.suscripcion.activo == true || 
                   (request.auth != null && request.auth.token.isSuperAdmin == true) ||
                   (request.auth != null && request.auth.token.clientId == clienteId);
      
      // Escritura: solo si está autenticado
      allow write: if request.auth != null;
    }
    
    // ========== REGLA PARA PEDIDOS ==========
    match /artifacts/{appId}/public/data/pedidos/{pedidoId} {
      allow read, write: if true;
    }
    
    // ========== REGLA PARA REFERIDOS ==========
    match /artifacts/{appId}/public/data/referidos/{referidoId} {
      allow read, write: if true;
    }
    
    // ========== REGLA PARA ESTADÍSTICAS ==========
    match /artifacts/{appId}/public/data/estadisticas/{estadisticaId} {
      allow read, write: if true;
    }
  }
}
